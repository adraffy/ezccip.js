{
	"name": "@namestone/ezccip",
	"version": "0.1.2",
	"type": "module",
	"description": "Turnkey CCIP-Read Handler",
	"license": "MIT",
	"author": "raffy.eth",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/namestonehq/ezccip.js.git"
	},
	"bugs": {
		"url": "https://github.com/namestonehq/ezccip.js/issues"
	},
	"homepage": "https://github.com/namestonehq/ezccip.js#readme",
	"keywords": [
		"ENS",
		"Ethereum Naming System",
		"Ethereum",
		"EIP-3668",
		"ENSIP-10",
		"CCIP",
		"CCIP-Read",
		"Offchain"
	],
	"scripts": {
		"check": "tsc --noEmit",
		"test": "bun test",
		"start": "bun run demo.ts",
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"prepublishOnly": "bun run check && bun test && bun run build"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"./dist",
		"./src"
	],
	"sideEffects": false,
	"dependencies": {
		"abitype": "^1.3.0",
		"ox": "^1.8.16"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2",
		"viem": "^2.58.0"
	}
}
