{
	"name": "@namestone/ezccip",
	"version": "0.2.0",
	"type": "module",
	"description": "Turnkey CCIP-Read Handler",
	"license": "MIT",
	"author": "raffy.eth",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/namestonehq/ezccip.js.git"
	},
	"bugs": {
		"url": "https://github.com/namestonehq/ezccip.js/issues"
	},
	"homepage": "https://github.com/namestonehq/ezccip.js#readme",
	"keywords": [
		"ENS",
		"Ethereum Naming System",
		"Ethereum",
		"EIP-3668",
		"ENSIP-10",
		"CCIP",
		"CCIP-Read",
		"Offchain"
	],
	"scripts": {
		"check": "tsc --noEmit",
		"lint": "biome check",
		"format": "biome check --write",
		"test": "bun test",
		"start": "bun run scripts/demo.ts",
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"prepublishOnly": "bun run check && bun run lint && bun test && bun run build",
		"smoke": "bun run build && node scripts/smoke.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./serve": {
			"types": "./dist/serve.d.ts",
			"import": "./dist/serve.js"
		}
	},
	"files": [
		"./dist",
		"./src"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"abitype": "^1.2.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@types/bun": "^1.4.4",
		"@types/node": "^22",
		"typescript": "^7.0.2",
		"viem": "^2.58.0"
	},
	"peerDependencies": {
		"viem": "^2.30.0"
	}
}
